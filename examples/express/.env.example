# Apple
APPLE_BUNDLE_ID=com.example.app
APPLE_APP_APPLE_ID=1234567890
# Optional: App Store Server API (enables verify by transactionId + live subscription status)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Google
GOOGLE_PACKAGE_NAME=com.example.app
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
GOOGLE_CONSUMABLE_PRODUCT_IDS=coins_100
# Pub/Sub push subscription → "Enable authentication" → audience
GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@your-project.iam.gserviceaccount.com

# openssl rand -base64 48
IAP_ACCOUNT_TOKEN_SECRET=
